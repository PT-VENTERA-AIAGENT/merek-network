# ============ SUPABASE ============
# Anon key (public — safe to expose, no RLS bypass)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side only — service role bypasses RLS, jangan pernah expose ke client
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============ OPENAI ============
# Server-side only
OPENAI_API_KEY=sk-...

# ============ RATE LIMIT (Upstash Redis) ============
# Persistent rate limit yang survive cold-start Vercel serverless.
# Signup di https://console.upstash.com/ — free tier 10k req/day cukup.
# Kalau tidak diset di production, sistem fallback ke in-memory Map (loud warn),
# yang TIDAK protect antar cold-start. Wajib diset di prod.
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ============ ALERT WEBHOOK (opsional) ============
# Slack/Discord webhook untuk notif kalau daily cap approach 80% atau tercapai 100%.
# Kalau kosong, alert cuma masuk log Vercel (tetap ada).
ALERT_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
